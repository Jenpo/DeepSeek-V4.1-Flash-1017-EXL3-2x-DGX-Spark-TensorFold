# Lane settings: copy to config/lane.env and fill in the placeholders.
# Anything exported in the environment wins over this file.

# --- nodes -------------------------------------------------------------------------------------
# The worker's link address, reachable over key-based ssh from the head.
WORKER_SSH="CHANGE-ME-worker"              # e.g. user@CHANGE-ME-link-ip (your fabric link address)
# The head's link address; rank 1 rendezvouses here, rank 0 listens here.
HEAD_ADDR="CHANGE-ME-head"                # e.g. CHANGE-ME-link-ip (your fabric link address)
HEAD_BIND=0.0.0.0                    # bind 0.0.0.0 only behind a firewall (see API_KEY_FILE)
PORT=8888
SERVED_NAME=DeepSeek-v4.1-Flash-EXL3
TP_PORT=29620
NAME=dsv41-zig

# --- files (same paths on both nodes unless noted) ---------------------------------------------
IMAGE="CHANGE-ME-image"                        # e.g. tensorfold-dsv41:exl3-tp2
MODEL_DIR="CHANGE-ME-model_dir"                # the EXL3 pack snapshot directory
ENGRAM_DIR="CHANGE-ME-engram_dir"              # shards 47 and 48 (see docs/ENGRAM_DISK.md)
RANK_CACHE_DIR="CHANGE-ME-rank_cache_dir"      # written on first start, ~93 GB per node
TOKEN_MAP="CHANGE-ME-token_map"                # dsv41_token_map.json, written on first start
KIT_DIR="CHANGE-ME-kit_dir"                    # the kernel kit (aot/, cubins/, rope.json, vision/, grammar/)
ENGINE_DIR="CHANGE-ME-engine_dir"              # holds tensorfold-native and tf-ds41-lanes
SPILL_DIR=                           # empty: no spill tier; e.g. /home/<you>/dsv41-spill
SPILL_GIB=0

# --- serving -----------------------------------------------------------------------------------
CONTEXT=524288                       # window; 1048576 works on a head with nothing else on it
POOL=1048576                         # KV pool; > CONTEXT keeps more long prompts resident
PARALLEL=4
STREAMS=4                            # usually = PARALLEL
ROUND_ROWS=16                        # keep 16 with the pinned kit (docs/TUNING.md)
MAX_TOKENS=32768
THINKING=1
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=20                             # never 0 or -1 (docs/TUNING.md section 5)
DRAFTS=1
GRAPHS=1
REPLAY_FLOOR=1

# --- fabric ------------------------------------------------------------------------------------
RDMA_DEVICES=rocep1s0f0,roceP2p1s0f0
RDMA_GID_INDEX=3                     # must equal NCCL_IB_GID_INDEX; check with show_gids
SOCKET_IFNAME=enp1s0f0np0
RDMA_IDLE_S=2
RDMA_NAP_US=500

# --- guards ------------------------------------------------------------------------------------
MIN_AVAIL_GIB=112                    # do not lower (docs/MEMORY.md)
MIN_AVAIL_WAIT_S=120
READY_TIMEOUT=2400
API_KEY_FILE=                        # path to a 600-mode key file; enables auth on every route but /health
EXTRA_ENV=                           # extra -e arguments, space separated, appended to both ranks
